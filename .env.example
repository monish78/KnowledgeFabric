# Copy to .env and fill in. Never commit .env.

# ---------- Postgres ----------
POSTGRES_DB=graphbase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port only (inside Docker the backend uses postgres:5432)
POSTGRES_HOST_PORT=5433

# ---------- Neo4j ----------
NEO4J_USER=neo4j
# Neo4j 5 rejects "neo4j" as a password and needs >= 8 characters
NEO4J_PASSWORD=neo4j123
# single = Community, all KBs in one database isolated by a per-KB label
# multi  = Enterprise, one Neo4j database per KB
NEO4J_MODE=single
NEO4J_IMAGE=neo4j:5-community
# Set to "yes" only when using the enterprise image and you hold a licence
NEO4J_ACCEPT_LICENSE=no
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m
# Host ports (change if taken; containers talk to each other on their internal ports)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- Chroma ----------
CHROMA_VERSION=0.6.3
CHROMA_HOST_PORT=8001

# ---------- LLM / embeddings ----------
# ollama (active) | azure (code present, commented out)
LLM_PROVIDER=ollama
# Where the backend container finds Ollama:
#  - host Ollama bound to 127.0.0.1 (Linux): enable the ollama-proxy profile below and use :11435
#  - host Ollama bound to 0.0.0.0, or Docker Desktop: http://host.docker.internal:11434
#  - Ollama in Compose (profile "ollama"): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window and per-call timeout for the local model
OLLAMA_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=600

# Azure OpenAI (used only when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# ---------- Auth ----------
# local = user ID + password checked by the backend | keycloak = sign-in through Keycloak (run by the backend)
AUTH_PROVIDER=local
# Encrypts the Keycloak tokens kept in server-side sessions: openssl rand -hex 32
SECRET_KEY=generate-a-long-random-string
# Sessions are server-side; the browser only gets an HttpOnly cookie.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# true when the app is served over https
SESSION_COOKIE_SECURE=false
# Browser-facing address of the app; Keycloak redirects back to APP_URL/api/auth/callback
APP_URL=http://localhost:5173

# Browser-facing Keycloak URL (token issuer is ${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM})
KEYCLOAK_URL=http://localhost:8080
# URL the backend container uses to talk to Keycloak (token exchange, keys, logout)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=graphbase
KEYCLOAK_CLIENT_ID=graphbase-app
# Only for a confidential client; leave blank for a public client (PKCE is always used)
KEYCLOAK_CLIENT_SECRET=

# Local Keycloak container (profile "keycloak") admin console login
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---------- Compose profiles ----------
# Comma-separated optional services to start with `docker compose up`: ollama-proxy, ollama, keycloak
COMPOSE_PROFILES=ollama-proxy

# ---------- Ports ----------
# Host ports only. The frontend reaches the backend inside Docker, so these can be any free ports.
# If you change FRONTEND_PORT, also update APP_URL (and the Keycloak redirect URI).
BACKEND_PORT=8000
FRONTEND_PORT=5173
